<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>downstream_bin_a</name>
  <version>0.1.0</version>
  <description>
    Package of the binext distribution of the REP-159 test harness: a shared
    library on top of rcl. binext extends ROS 2 Lyrical with binary_import,
    so rcl and everything below it come from the ros-lyrical-* debs.
  </description>
  <maintainer email="jrivero@honurobotics.com">Jose Luis Rivero</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rcl</depend>

  <!-- A build_depend too: a ros_buildfarm ci job configures the tests in its
       build phase, where test_depend packages are not installed. -->
  <build_depend>ament_cmake_gtest</build_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
